# ============================================================================
# e-conomic MCP server – configuration
# Copy to .env for local use. On Railway, set these as service variables instead.
# Full walkthrough: GUIDE.md (Danish) / README.md (English)
# ============================================================================

# --- e-conomic API tokens (https://www.e-conomic.com/developer/connect) -----
# "demo" = e-conomic's read-only demo agreement, no registration needed.
ECONOMIC_APP_SECRET_TOKEN=demo
ECONOMIC_AGREEMENT_GRANT_TOKEN=demo

# --- Who may use the server? Pick at least one. The server refuses to start
#     without authentication (unless MCP_ALLOW_UNAUTHENTICATED=true, local only).

# Option A – Google login (Google Workspace or Gmail). An allowlist is REQUIRED.
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# MCP_ALLOWED_DOMAINS=firma.dk
# MCP_ALLOWED_EMAILS=revisor@ekstern.dk,bogholder@firma.dk

# Option B – Microsoft login (Microsoft 365 / Entra ID). Your tenant ID limits
#            access to your own organisation; the allowlist is optional.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=...
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_API_SCOPE=access_as_user        # scope name created under "Expose an API"
# MCP_ALLOWED_EMAILS=...                # optional extra restriction

# Option C – Personal access keys (simplest, no identity provider). One variable per person,
#            32+ characters each:  python scripts/new_key.py <name>
#            The name becomes the identity in the audit log; delete the variable to revoke.
#            MCP_AUTH_TOKEN without a name is for automations. Can be combined with A or B.
# MCP_AUTH_TOKEN_CFO=
# MCP_AUTH_TOKEN_ANNA=
# MCP_AUTH_TOKEN=

# Public https URL of the server – required for Google/Microsoft login.
# On Railway it is derived automatically from RAILWAY_PUBLIC_DOMAIN; leave it unset there.
# MCP_PUBLIC_URL=https://my-app.up.railway.app

# --- Safety switches ---------------------------------------------------------
# Hide every tool that creates, changes, books or deletes anything. Start like this.
MCP_READ_ONLY=true

# Local testing only. The server then listens on 127.0.0.1 and warns loudly.
# MCP_ALLOW_UNAUTHENTICATED=true

# --- Optional ----------------------------------------------------------------
# MCP_JWT_SIGNING_KEY=                  # openssl rand -hex 32 – keeps logins valid when you rotate the OAuth secret
# MCP_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,https://claude.ai/*
# MCP_HOST=0.0.0.0                      # default: 0.0.0.0 with auth, 127.0.0.1 without
# PORT=8000                             # set automatically by Railway
# FASTMCP_HOME=/data/fastmcp            # where login sessions live; set automatically when a Railway volume is attached
# ECONOMIC_BASE_URL=https://restapi.e-conomic.com
# ECONOMIC_REQUEST_TIMEOUT_SECONDS=30
# ECONOMIC_MAX_RETRIES=2
# LOG_LEVEL=INFO
